# Copy this file to ".env" and put your real key there.
# NEVER upload the .env file to GitHub.

# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here 

# Port of this Node.js server
PORT=3000

# Where the ChromaDB server is running (start it with: chroma run --path ./chroma_data --port 8001)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Optional: change the models if you want
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
